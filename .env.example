# Tên miền gốc dùng cho mọi đường dẫn QR (FR-37). Không có dấu / ở cuối.
SITE_URL=https://pet-memory-box.vercel.app

# Supabase Postgres
# Runtime: connection pooler, BẮT BUỘC cổng 6543 (transaction mode). Cổng 5432 chỉ có 15 kết nối
# và Vercel sẽ báo "EMAXCONNSESSION max clients reached in session mode".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrate và seed: kết nối trực tiếp (session mode, cổng 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase Storage (chỉ dùng ở máy chủ, không đưa ra trình duyệt).
# Chạy `npm run storage:setup` một lần để tạo bucket pet-media.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Dung lượng tối đa mỗi video (MB). Gói Free của Supabase chỉ cho 50.
VIDEO_MAX_MB=100
# Khi phát triển trên máy chưa có Supabase: STORAGE_DRIVER=local lưu tệp vào .local-storage
# STORAGE_DRIVER=local

# Chuỗi bí mật cho tác vụ dọn dẹp hằng ngày (Vercel Cron tự gửi kèm)
CRON_SECRET=

# Gửi email (mã đăng nhập chủ nuôi, báo có người quét, đơn hàng, lời nhắn).
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail>, SMTP_PASS=<mật khẩu ứng dụng 16 ký tự>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Furever <email-cua-ban@gmail.com>"
# Khi phát triển: MAIL_DRIVER=console in email ra log, MAIL_DRIVER=file ghi vào .local-outbox/mail.jsonl
# MAIL_DRIVER=console

# Muối để băm IP trong scan_logs (FR-33). Chuỗi ngẫu nhiên dài.
IP_HASH_SALT=

# Tài khoản admin đầu tiên, chỉ dùng khi chạy `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
