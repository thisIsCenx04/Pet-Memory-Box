# Tên miền gốc dùng cho mọi đường dẫn QR (FR-37). Không có dấu / ở cuối.
SITE_URL=https://pet-memory-box.vercel.app

# Supabase Postgres
# Runtime: connection pooler (transaction mode, cổng 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrate và seed: kết nối trực tiếp (session mode, cổng 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase Storage (chỉ dùng ở máy chủ, không đưa ra trình duyệt)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Muối để băm IP trong scan_logs (FR-33). Chuỗi ngẫu nhiên dài.
IP_HASH_SALT=

# Tài khoản admin đầu tiên, chỉ dùng khi chạy `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
