// Pet Memory Box – lược đồ dữ liệu (SRS v2, mục 14)
// Các ràng buộc Prisma không biểu diễn được (sequence, chỉ mục một phần, CHECK, pg_trgm)
// nằm trong migration SQL thủ công.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Species {
  dog
  cat
  other
}

enum Gender {
  male
  female
  unknown
}

enum LifeStatus {
  alive
  memorial
}

enum PetStatus {
  active
  archived
}

enum QrStatus {
  active
  locked
  replaced
}

enum VideoSource {
  upload
  youtube
  vimeo
}

enum OrderPackage {
  full_box
  tag_only
}

enum OrderStatus {
  received
  preparing
  issued
  delivered
}

enum ScanResult {
  ok
  not_found
  locked
  replaced
  archived
}

enum AuditAction {
  create
  update
  lock
  unlock
  reissue
  archive
  restore
  memorial
  password_change
  payment
  convert
  moderate
}

enum GuestbookStatus {
  pending
  approved
  rejected
}

enum OrderRequestStatus {
  pending_payment
  paid
  converted
  cancelled
}

model AdminUser {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique // luôn lưu chữ thường
  passwordHash   String         @map("password_hash")
  failedAttempts Int            @default(0) @map("failed_attempts")
  lockedUntil    DateTime?      @map("locked_until") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  sessions       AdminSession[]
  auditLogs      AuditLog[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Owner {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name")
  phone         String
  phone2        String?
  zaloMessenger String?  @map("zalo_messenger")
  area          String?
  address       String?
  email         String? // luôn lưu chữ thường; dùng để chủ nuôi đăng nhập bằng OTP
  notifyScan    Boolean  @default(true) @map("notify_scan")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  pets          Pet[]
  orders        Order[]

  @@index([phone])
  @@index([email])
  @@map("owners")
}

model Pet {
  id          String              @id @default(uuid()) @db.Uuid
  cardNo      String              @unique @map("card_no")
  ownerId     String              @map("owner_id") @db.Uuid
  name        String
  species     Species
  breed       String?
  gender      Gender              @default(unknown)
  birthDate   DateTime?           @map("birth_date") @db.Date
  coatColor   String?             @map("coat_color")
  traits      String?
  note        String?
  tagline     String?
  lifeStatus  LifeStatus          @default(alive) @map("life_status")
  passedDate  DateTime?           @map("passed_date") @db.Date
  status      PetStatus           @default(active)
  archivedAt  DateTime?           @map("archived_at") @db.Timestamptz
  version     Int                 @default(1)
  lastScanNotifiedAt DateTime?    @map("last_scan_notified_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  owner       Owner               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  foundReports  FoundReport[]
  guestbook     GuestbookEntry[]
  orderRequests OrderRequest[]
  visibility  VisibilitySettings?
  qrTags      QrTag[]
  media       MediaAsset[]
  videos      Video[]
  memories    Memory[]
  orders      Order[]

  @@index([ownerId])
  @@index([status, createdAt(sort: Desc)])
  @@map("pets")
}

model VisibilitySettings {
  petId          String  @id @map("pet_id") @db.Uuid
  showCallButton Boolean @default(true) @map("show_call_button")
  showPhone      Boolean @default(true) @map("show_phone")
  showPhone2     Boolean @default(false) @map("show_phone2")
  showArea       Boolean @default(true) @map("show_area")
  showAddress    Boolean @default(false) @map("show_address")
  showNote       Boolean @default(true) @map("show_note")
  showMedia      Boolean @default(true) @map("show_media")
  showMemories   Boolean @default(true) @map("show_memories")
  showGuestbook  Boolean @default(true) @map("show_guestbook")
  pet            Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("visibility_settings")
}

model QrTag {
  id           String     @id @default(uuid()) @db.Uuid
  petId        String     @map("pet_id") @db.Uuid
  token        String     @unique @db.Char(22)
  status       QrStatus   @default(active)
  lockReason   String?    @map("lock_reason")
  issuedAt     DateTime   @default(now()) @map("issued_at") @db.Timestamptz
  lockedAt     DateTime?  @map("locked_at") @db.Timestamptz
  replacedAt   DateTime?  @map("replaced_at") @db.Timestamptz
  replacedById String?    @unique @map("replaced_by_id") @db.Uuid
  pet          Pet        @relation(fields: [petId], references: [id], onDelete: Restrict)
  replacedBy   QrTag?     @relation("QrReplacement", fields: [replacedById], references: [id])
  replaces     QrTag?     @relation("QrReplacement")
  scans        ScanLog[]

  @@index([petId])
  @@map("qr_tags")
}

model MediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  petId      String   @map("pet_id") @db.Uuid
  storageKey String   @map("storage_key")
  url        String
  thumbKey   String?  @map("thumb_key") // bản nhỏ cho lưới ảnh (NFR-02)
  thumbUrl   String?  @map("thumb_url")
  width      Int?
  height     Int?
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  caption    String?
  sortOrder  Int      @default(0) @map("sort_order")
  isCover    Boolean  @default(false) @map("is_cover")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, sortOrder])
  @@map("media_assets")
}

model Video {
  id          String      @id @default(uuid()) @db.Uuid
  petId       String      @map("pet_id") @db.Uuid
  source      VideoSource
  title       String?
  url         String
  storageKey  String?     @map("storage_key")
  posterKey   String?     @map("poster_key")
  posterUrl   String?     @map("poster_url")
  mimeType    String?     @map("mime_type")
  sizeBytes   BigInt?     @map("size_bytes")
  durationSec Int?        @map("duration_sec")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  pet         Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, sortOrder])
  @@map("videos")
}

model Memory {
  id         String    @id @default(uuid()) @db.Uuid
  petId      String    @map("pet_id") @db.Uuid
  title      String
  memoryDate DateTime? @map("memory_date") @db.Date
  content    String
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  pet        Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, sortOrder])
  @@map("memories")
}

model Order {
  id              String       @id @default(uuid()) @db.Uuid
  ownerId         String       @map("owner_id") @db.Uuid
  petId           String       @map("pet_id") @db.Uuid
  package         OrderPackage
  status          OrderStatus  @default(received)
  statusChangedAt DateTime     @default(now()) @map("status_changed_at") @db.Timestamptz
  note            String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  owner           Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pet             Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([petId])
  @@map("orders")
}

model ScanLog {
  id        BigInt     @id @default(autoincrement())
  qrTagId   String?    @map("qr_tag_id") @db.Uuid
  scannedAt DateTime   @default(now()) @map("scanned_at") @db.Timestamptz
  result    ScanResult
  ipHash    String     @map("ip_hash")
  userAgent String?    @map("user_agent")
  qrTag     QrTag?     @relation(fields: [qrTagId], references: [id])

  @@index([qrTagId, scannedAt(sort: Desc)])
  @@index([scannedAt])
  @@index([ipHash, scannedAt]) // giới hạn tốc độ theo IP (FR-34)
  @@map("scan_logs")
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  adminId    String?     @map("admin_id") @db.Uuid
  actorEmail String?     @map("actor_email") // chủ nuôi thực hiện thao tác
  action     AuditAction
  targetType String      @map("target_type")
  targetId   String      @map("target_id") @db.Uuid
  detail     String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  admin      AdminUser?  @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("site_settings")
}

model OwnerOtp {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt(sort: Desc)])
  @@map("owner_otps")
}

model OwnerSession {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([expiresAt])
  @@map("owner_sessions")
}

/// Người nhặt được bé gửi vị trí hoặc lời nhắn từ trang công khai
model FoundReport {
  id            String   @id @default(uuid()) @db.Uuid
  petId         String   @map("pet_id") @db.Uuid
  qrTagId       String?  @map("qr_tag_id") @db.Uuid
  latitude      Float?
  longitude     Float?
  accuracyM     Int?     @map("accuracy_m")
  message       String?
  finderContact String?  @map("finder_contact")
  ipHash        String   @map("ip_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@map("found_reports")
}

model GuestbookEntry {
  id          String          @id @default(uuid()) @db.Uuid
  petId       String          @map("pet_id") @db.Uuid
  authorName  String          @map("author_name")
  message     String
  status      GuestbookStatus @default(pending)
  ipHash      String          @map("ip_hash")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  moderatedAt DateTime?       @map("moderated_at") @db.Timestamptz
  pet         Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, status, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@map("guestbook_entries")
}

/// Đơn khách tự đặt trên web, trước khi admin tạo hồ sơ
model OrderRequest {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  accessToken  String             @unique @map("access_token")
  package      OrderPackage
  amount       Int?
  status       OrderRequestStatus @default(pending_payment)
  customerName String             @map("customer_name")
  phone        String
  email        String?
  address      String
  petName      String             @map("pet_name")
  species      Species
  breed        String?
  gender       Gender             @default(unknown)
  lifeStatus   LifeStatus         @default(alive) @map("life_status")
  birthDate    DateTime?          @map("birth_date") @db.Date
  passedDate   DateTime?          @map("passed_date") @db.Date
  note         String?
  ipHash       String             @map("ip_hash")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  paidAt       DateTime?          @map("paid_at") @db.Timestamptz
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz
  petId        String?            @map("pet_id") @db.Uuid
  pet          Pet?               @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@map("order_requests")
}
